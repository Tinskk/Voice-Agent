# --- Vapi ---
# API key for tools/ scripts that manage the assistant/phone number via Vapi's REST API.
VAPI_API_KEY=
# Shared secret Vapi sends back as the X-Vapi-Secret header on every tool-call
# webhook — set the SAME value on the assistant's server config. Invent any
# long random string. See workflows/setup_vapi_assistant.md.
VAPI_WEBHOOK_SECRET=
# Filled in after tools/create_or_update_vapi_assistant.py's first run.
VAPI_ASSISTANT_ID=
# Filled in after tools/provision_vapi_phone_number.py's first run. Not read
# by any script — kept for reference.
VAPI_PHONE_NUMBER_ID=
# The deployed app/ URL (after workflows/deploy_agent_server.md), e.g.
# https://your-app.onrender.com — tools/create_or_update_vapi_assistant.py
# points every custom tool's webhook at "<this>/vapi/tool-calls".
AGENT_SERVER_URL=
# Optional overrides for the assistant's model/voice/transcriber — sensible
# defaults are baked into tools/create_or_update_vapi_assistant.py.
# VAPI_MODEL_PROVIDER=anthropic
# VAPI_MODEL_NAME=claude-sonnet-5
# VAPI_VOICE_PROVIDER=11labs
# VAPI_VOICE_ID=
# VAPI_TRANSCRIBER_PROVIDER=deepgram
# VAPI_TRANSCRIBER_MODEL=nova-2

# --- Google (one service account, shared by Sheets + Calendar) ---
# Base64-encode the whole service account JSON key file, e.g.:
#   macOS/Linux: base64 -i service-account.json | tr -d '\n'
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SHEETS_SPREADSHEET_ID=
# The target calendar's ID (its own address for a dedicated Google account, or
# the "Calendar ID" from a personal calendar's settings), shared with the
# service account's client_email as "Make changes to events".
GOOGLE_CALENDAR_ID=

# --- Business config ---
# Generic Lagos, Nigeria restaurant defaults below — replace with the real
# business's own name/hours/zones via workflows/seed_and_verify_business_data.md.
BUSINESS_NAME=Lagos Bites
# IANA timezone — required for correct hours/calendar math.
BUSINESS_TIMEZONE=Africa/Lagos
# One entry per day, 24h HH:MM-HH:MM, or "closed". Used for FAQ answers and to
# bound reservation-availability search.
BUSINESS_HOURS_JSON={"mon":"09:00-22:00","tue":"09:00-22:00","wed":"09:00-22:00","thu":"09:00-22:00","fri":"09:00-22:00","sat":"09:00-22:00","sun":"11:00-21:00"}
# Delivery zones for calculate_order_total/create_order: a list of
# {"name","keywords":[...],"fee"} objects, matched by substring against the
# spoken/collected delivery address. Fees in NGN. See
# workflows/seed_and_verify_business_data.md.
DELIVERY_ZONES_JSON=[{"name":"Lekki & Ajah","keywords":["lekki","ajah","vgc","chevron"],"fee":1500},{"name":"Victoria Island & Ikoyi","keywords":["victoria island","v.i.","vi","ikoyi"],"fee":1200},{"name":"Ikeja & GRA","keywords":["ikeja","gra","opebi","allen"],"fee":2000},{"name":"Yaba & Surulere","keywords":["yaba","surulere","onipanu"],"fee":1800},{"name":"Lagos Island","keywords":["lagos island","marina","cms","obalende"],"fee":1500}]
# Fee applied when no zone's keywords match the address (NGN).
DEFAULT_DELIVERY_FEE=2500
# Granularity (minutes) offered by check_calendar_availability.
RESERVATION_SLOT_MINUTES=30
# Default event length (minutes) for book_appointment when not specified.
RESERVATION_DEFAULT_DURATION_MINUTES=90
# Phone number Vapi's transferCall tool dials for escalations (complaints,
# large catering quotes, manager requests). E.g. +15551234567.
ESCALATION_TRANSFER_NUMBER=

# --- App ---
# Optional — defaults to app/data/agent.db relative to app/'s own location,
# which is correct regardless of the process's working directory. Only set
# this if you need the SQLite file somewhere else (an absolute path).
# AGENT_DB_PATH=
